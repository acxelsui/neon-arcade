{
  "name": "neon-owner-remote",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{"name": "NEON_REMOTE_STATE", "class_name": "NeonRemoteRelay"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["NeonRemoteRelay"]}],
  "observability": {"enabled": false}
}
